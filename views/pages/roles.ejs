<%
const avMap = {'Owner':'av-c','Admin':'av-p','Editor':'av-t','Viewer':'av-b','Auditor':'av-p'};
%>
<%- include('../partials/layout', {body: `
<div class="d-flex justify-content-between align-items-center mb-4">
  <p class="text-muted fs-13 mb-0">Manage roles and their associated permissions.</p>
  <button class="btn btn-purple btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createRoleModal">+ Create role</button>
</div>

<div class="row g-3">
  ${roles.map(r => {
    const av = avMap[r.name] || 'av-b';
    const ini = r.name.slice(0,2).toUpperCase();
    const totalPerms = r.permissions.reduce((sum, p) => sum + p.actions.length, 0);
    return `
    <div class="col-md-4">
      <div class="role-card">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="avatar ${av}" style="width:40px;height:40px;font-size:14px">${ini}</div>
          <div>
            <div class="fw-500 fs-14">${r.name}</div>
            <div class="fs-11 text-muted">${totalPerms} permission${totalPerms!==1?'s':''} · ${r.isSystem?'System role':'Custom role'}</div>
          </div>
          ${r.isSystem ? '<span class="ms-auto" style="font-size:11px;background:#EAF3DE;color:#3B6D11;padding:2px 8px;border-radius:4px">System</span>' : ''}
        </div>
        <p class="text-muted fs-12 mb-3" style="line-height:1.5">${r.description || 'No description.'}</p>
        <div class="mb-3">
          ${r.permissions.slice(0,3).map(p => `
          <div class="d-flex align-items-center justify-content-between mb-1">
            <span class="fs-12 text-muted">${p.resource}</span>
            <span class="fs-11" style="color:#888">${p.actions.join(', ')}</span>
          </div>`).join('')}
          ${r.permissions.length > 3 ? `<div class="fs-11 text-muted mt-1">+${r.permissions.length-3} more resources</div>` : ''}
        </div>
        <div class="d-flex gap-2">
          <a href="/permissions" class="btn btn-sm btn-outline-secondary flex-grow-1">Edit permissions</a>
          ${!r.isSystem ? `
          <form action="/roles/${r._id}?_method=DELETE" method="POST" onsubmit="return confirm('Delete role ${r.name}?')">
            <button class="btn btn-sm" style="background:#FCEBEB;color:#A32D2D;border:1px solid #F7C1C1">Delete</button>
          </form>` : ''}
        </div>
      </div>
    </div>`;
  }).join('')}
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content" style="border-radius:12px;border:1px solid #e5e3da">
      <div class="modal-header border-bottom" style="border-color:#e5e3da!important">
        <h5 class="modal-title fs-15 fw-600">Create new role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/roles" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-500 fs-13">Role name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Analyst" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-500 fs-13">Description</label>
            <input type="text" name="description" class="form-control" placeholder="Brief description of this role">
          </div>
        </div>
        <div class="modal-footer border-top" style="border-color:#e5e3da!important">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-purple btn-sm">Create role</button>
        </div>
      </form>
    </div>
  </div>
</div>
`}) %>
