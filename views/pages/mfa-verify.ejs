<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Two-Factor Authentication — AccessIQ</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<div class="login-page">
  <div class="login-card" style="max-width:420px">
    <div class="login-logo">
      <div class="brand-icon" style="background:#0F6E56">2F</div>
      <span style="font-size:18px;font-weight:600">Two-Factor Auth</span>
    </div>

    <% if (typeof riskScore !== 'undefined' && riskScore >= 35) { %>
    <div class="alert py-2 fs-12 mb-4" style="background:#FFF3CD;border:1px solid #FFECB5;color:#664d03">
      <i class="bi bi-exclamation-triangle me-1"></i>
      <strong>Risk Score: <%= riskScore %>/100</strong> — Extra verification required.<br>
      <% if (typeof riskFactors !== 'undefined' && riskFactors.length) { %>
        <span class="text-muted" style="font-size:11px">Factors: <%= riskFactors.join(', ') %></span>
      <% } %>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="alert alert-danger py-2 fs-13 mb-3">
        <i class="bi bi-exclamation-circle me-2"></i><%= Array.isArray(error) ? error[0] : error %>
      </div>
    <% } %>

    <p class="text-muted fs-13 mb-4">Enter the 6-digit code from your authenticator app, or a backup code.</p>

    <form action="/mfa/verify" method="POST">
      <div class="mb-4">
        <label class="form-label fs-13 fw-500">Verification Code</label>
        <input type="text" name="token"
               class="form-control text-center"
               style="font-size:24px;letter-spacing:8px;font-weight:600"
               placeholder="000000" maxlength="8"
               autocomplete="one-time-code" autofocus required>
        <div class="form-text fs-11 mt-1">Enter 6-digit TOTP code or your backup code</div>
      </div>
      <button type="submit" class="btn w-100" style="background:#0F6E56;color:#fff">
        <i class="bi bi-shield-check me-1"></i>Verify Identity
      </button>
    </form>

    <div class="mt-3 text-center">
      <a href="/login" class="fs-12 text-muted">← Cancel and return to login</a>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
