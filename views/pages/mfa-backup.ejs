<%- include('../partials/layout', {body: `
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="panel">
      <div class="panel-header"><span class="panel-title">🗝️ Backup Codes — Save These Now</span></div>
      <div class="p-4">
        <div class="alert alert-warning fs-13">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Save these codes somewhere safe.</strong> Each can be used once if you lose your authenticator. They will not be shown again.
        </div>
        <div class="p-3 rounded font-monospace" style="background:#1a1a1a;color:#a8e6cf;line-height:2.2;font-size:14px">
          ${codes.map((c,i) => `<span class="me-4">${i+1}. ${c}</span>${(i+1)%2===0?'<br>':''}`).join('')}
        </div>
        <div class="mt-4 d-flex gap-2">
          <button onclick="navigator.clipboard.writeText('${codes.join('\\n')}').then(()=>alert('Copied!'))" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clipboard me-1"></i> Copy all
          </button>
          <a href="/dashboard" class="btn btn-purple btn-sm ms-auto">
            <i class="bi bi-check-circle me-1"></i> Done, I've saved them
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
`}) %>
